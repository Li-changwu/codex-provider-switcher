{
  "name": "codex-provider-switcher",
  "displayName": "Codex Provider Switcher",
  "version": "0.1.0",
  "private": true,
  "publisher": "Li-changwu",
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.92.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexProvider.createProfile",
        "title": "Codex: Create Profile"
      },
      {
        "command": "codexProvider.switchProfile",
        "title": "Codex: Switch Profile"
      },
      {
        "command": "codexProvider.syncSessions",
        "title": "Codex: Sync Sessions"
      },
      {
        "command": "codexProvider.continueSession",
        "title": "Codex: Continue Session"
      },
      {
        "command": "codexProvider.restoreBackup",
        "title": "Codex: Restore Backup"
      }
    ],
    "menus": {
      "statusBar": [
        {
          "command": "codexProvider.switchProfile",
          "when": "true",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "package": "npm run check && npm run build && npx @vscode/vsce package",
    "verify:package": "node scripts/verify-vsix.mjs"
  },
  "dependencies": {
    "@iarna/toml": "^3.0.0",
    "@vscode/sqlite3": "5.1.14-vscode"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.92.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^2.26.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "yauzl": "^2.10.0"
  }
}
